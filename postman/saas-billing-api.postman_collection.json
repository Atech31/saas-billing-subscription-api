{
  "info": {
    "name": "Multi-Tenant SaaS Billing API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Get Tenant Subscriptions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "company-alpha",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/subscriptions",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "subscriptions"]
            }
          }
        },
        {
          "name": "Create Subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "company-alpha",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/subscriptions?planId=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "subscriptions"],
              "query": [
                {
                  "key": "planId",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "Get Tenant Invoices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "company-alpha",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/invoices",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "invoices"]
            }
          }
        },
        {
          "name": "Generate Invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "company-alpha",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/invoices?amount=149.99",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "invoices"],
              "query": [
                {
                  "key": "amount",
                  "value": "149.99"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
